# --- LaLiga Fantasy ---
# Opcionales: si no los pones, se usa tu primera liga y se detecta tu equipo.
FANTASY_LEAGUE_ID=
FANTASY_TEAM_ID=

# --- Telegram (resumen de lo que hace el piloto automático) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ajustes ---
CLAUSE_WINDOW_HOURS=24     # avisar de cláusulas que se desbloquean en las próximas N horas
WATCH_INTERVAL_MIN=30      # cada cuánto revisa en modo watch
REPORT_HOUR=9              # hora del informe diario completo (report --telegram, bajo demanda)
REQUEST_DELAY_S=0.4        # pausa entre peticiones a la API
# FANTASY_DATA_DIR=./data  # tokens, SQLite

# --- Mensajes cortos y repartidos (ver STRATEGY.md) ---
BRIEFING_INTERVAL_MIN=90        # cada cuánto se manda el parte de situación corto
LINEUP_LOCK_HOURS=24            # ventana final antes de la jornada (fichaje a crédito de último recurso)

# --- Piloto automático (todo sin confirmación; los límites son económicos, no de nº de operaciones) ---
BUDGET_RESERVE_PCT=0.05         # % del saldo que nunca se gasta (contando pujas vivas y cláusulas reservadas)
MAX_SQUAD=16                    # tamaño máximo de plantilla que el planificador intenta llenar
DEBT_CEILING_PCT=0.20           # tope real del juego: máximo 20% del valor de plantilla en deuda
DEBT_MIN_HOURS_LEAD=36          # no se asume deuda en automático si faltan menos de N horas
                                 # para la jornada (una venta no es instantánea, necesita margen)
