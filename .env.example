# --- LaLiga Fantasy ---
# Opcionales: si no los pones, se usa tu primera liga y se detecta tu equipo.
FANTASY_LEAGUE_ID=
FANTASY_TEAM_ID=

# --- Telegram (alertas, informe diario y confirmación de pujas/cláusulas) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Ajustes ---
CLAUSE_WINDOW_HOURS=24     # avisar de cláusulas que se desbloquean en las próximas N horas
WATCH_INTERVAL_MIN=30      # cada cuánto revisa en modo watch
REPORT_HOUR=9              # hora del informe diario completo (report --telegram, bajo demanda)
REQUEST_DELAY_S=0.4        # pausa entre peticiones a la API
# FANTASY_DATA_DIR=./data  # tokens, SQLite

# --- Mensajes cortos y repartidos (ver STRATEGY.md) ---
BRIEFING_INTERVAL_MIN=90        # cada cuánto se manda el parte de situación corto
BUDGET_RESERVE_PCT=0.2          # % del saldo que nunca se propone gastar (colchón para cláusulas)
EMERGENCY_BUY_CAP_PCT=0.15      # tope por fichaje de emergencia (plantilla incompleta), % del saldo actual
EMERGENCY_BUYS_PER_WEEK=3       # máximo de fichajes de emergencia sin confirmar por semana
LINEUP_LOCK_HOURS=24            # el once no se aplica solo hasta N horas antes de la jornada
